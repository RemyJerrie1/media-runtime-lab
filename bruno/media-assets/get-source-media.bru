meta {
  name: Get Source Media (Range)
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/media/{{assetId}}
  body: none
  auth: none
}
headers {
  Range: bytes=0-1023
}
tests {
  test("source supports byte ranges", function () { expect(res.status).to.equal(206); expect(res.headers["content-range"]).to.include("bytes 0-1023/"); });
}
