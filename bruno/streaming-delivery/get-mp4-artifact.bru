meta {
  name: 讀取 MP4 成品（範圍請求）
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/artifacts/{{jobId}}.mp4
  body: none
  auth: none
}
headers {
  Range: bytes=0-1023
}
tests {
  test("artifact supports byte ranges", function () { expect(res.status).to.equal(206); expect(res.headers["content-type"]).to.include("video/mp4"); });
}
