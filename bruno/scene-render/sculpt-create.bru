meta {
 name: Versioned sculpt scene create
 type: http
 seq: 8
}
post {
 url: {{baseUrl}}/v1/scene-render-jobs
 body: json
 auth: none
}
headers {
 x-tenant-id: {{tenantId}}
 x-api-key: {{apiKey}}
}
body:json {
 {"version":1,"kind":"hamster-scene","idempotencyKey":"{{sculptKey}}","scene":{"version":4,"audio":null,"subject":"hamster","background":"#e8ddd0","transform":{"x":0,"z":0,"heading":0,"scale":1},"animation":{"durationSeconds":5,"end":{"x":0.6,"z":0,"heading":0}},"caption":{"enabled":false,"text":"小倉鼠，出發吧！","start":1,"end":4,"fontSize":48,"color":"#ffffff","background":"#252525"}}}
}
script:pre-request {
 bru.setVar("sculptKey", require("uuid").v4());
}
tests {
 test("new scene selects the accepted sculpt renderer", function() {
   expect(res.status).to.equal(201);
   expect(res.body.rendererVersion).to.equal("hamster-3");
   expect(res.body.scene.version).to.equal(4);
   expect(res.body.sceneFingerprint).to.have.length(64);
 });
}
