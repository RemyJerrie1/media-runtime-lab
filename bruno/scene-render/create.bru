meta {
 name: Scene create
 type: http
 seq: 1
}
post {
 url: {{baseUrl}}/v1/scene-render-jobs
 body: json
 auth: none
}
headers {
 x-tenant-id: {{tenantId}}
 x-api-key: {{apiKey}}
}
body:json {
 {"version": 1, "kind": "hamster-scene", "idempotencyKey": "{{sceneKey}}", "scene": {"version": 3, "subject": "hamster", "background": "#e8ddd0", "transform": {"x": 0, "z": 0, "heading": 0, "scale": 1}, "animation": {"durationSeconds": 5, "end": {"x": 0.6, "z": 0, "heading": 0}}, "caption": {"enabled": true, "text": "小倉鼠，出發吧！", "start": 1, "end": 4, "fontSize": 48, "color": "#ffffff", "background": "#252525"}}}
}
script:pre-request {
 bru.setVar("sceneKey", require("uuid").v4());
}
script:post-response {
 bru.setVar("sceneJobId", res.body.id);
}
tests {
 test("scene accepted", function(){ expect(res.status).to.equal(201); expect(res.body.kind).to.equal("hamster-scene"); expect(res.body.sceneFingerprint).to.have.length(64); });
}
