meta {
  name: Upload source media
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/v1/media
  body: multipartForm
  auth: none
}
headers {
  x-tenant-id: bruno-tenant
  x-api-key: local-demo-key
}
body:multipart-form {
  file: @file(../docs/media/product-demo.mp4)
}
script:post-response {
  bru.setVar("assetId", res.body.id);
}
tests {
  test("source media is stored and playable", function () { expect(res.status).to.equal(201); expect(res.body.id).to.be.a("string"); expect(res.body.url).to.include("/media/"); });
}
