meta {
  name: 查詢算圖任務
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/v1/render-jobs/{{jobId}}
  body: none
  auth: none
}
headers {
  x-tenant-id: {{tenantId}}
  x-api-key: {{apiKey}}
}
script:post-response {
  if (res.body.status === 'ready') {
    bru.setVar('artifactUrl', res.body.artifactUrl);
    bru.setVar('manifestUrl', res.body.manifestUrl);
    bru.setVar('streamBaseUrl', res.body.manifestUrl ? res.body.manifestUrl.replace(/\/master\.m3u8$/, '') : '');
  }
}
tests {
  test("job is addressable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("jobId"));
  });
}
