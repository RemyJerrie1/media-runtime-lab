meta {
  name: Get render job
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/v1/render-jobs/{{jobId}}
  body: none
  auth: none
}
headers {
  x-tenant-id: {{tenantId}}
  x-api-key: {{apiKey}}
}
tests {
  test("job is addressable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("jobId"));
  });
}
