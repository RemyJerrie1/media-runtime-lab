{
  "name": "media-runtime-lab",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-demo.ps1",
    "demo:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-demo.ps1",
    "demo:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-demo.ps1; powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-demo.ps1",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck && tsc -p e2e/tsconfig.json",
    "governance": "pnpm format:check && node --test scripts/check-boundaries.test.mjs scripts/codex-gate.test.mjs && node scripts/check-boundaries.mjs && node scripts/check-contract-drift.mjs && node scripts/check-a11y-colors.mjs",
    "verify": "pnpm governance && pnpm typecheck && pnpm test && pnpm build",
    "bruno": "node scripts/run-bruno.mjs",
    "prepare": "husky",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"scripts/*.mjs\" \"e2e/**/*.ts\" \"playwright*.config.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"scripts/*.mjs\" \"e2e/**/*.ts\" \"playwright*.config.ts\"",
    "test:e2e": "playwright test",
    "test:recovery": "playwright test --config playwright.recovery.config.ts",
    "benchmark": "pnpm --filter @media-lab/contracts build && node scripts/benchmark-encoding.mjs",
    "benchmark:verify": "pnpm --filter @media-lab/contracts build && node scripts/benchmark-encoding.mjs --verify",
    "test:ci": "node scripts/test-ci.mjs",
    "test:rwd": "playwright test --grep @rwd",
    "test:visual": "playwright test --config playwright.recovery.config.ts",
    "test:server": "pnpm --filter @media-lab/api test",
    "benchmark:web": "node scripts/benchmark-web.mjs --verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.0",
    "@usebruno/cli": "^4.0.0",
    "husky": "9.1.7",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
