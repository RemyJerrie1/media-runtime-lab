{
  "description": "Repository governance for Codex-assisted media development.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-governance.mjs\"",
            "commandWindows": "node -e \"const c=require('node:child_process');const p=c.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const r=c.spawnSync(process.execPath,[p+'/.codex/hooks/pre-tool-governance.mjs'],{stdio:'inherit'});process.exit(r.status===null?2:r.status)\"",
            "timeout": 10,
            "statusMessage": "Checking repository change policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/governance-gate.mjs\"",
            "commandWindows": "node -e \"const c=require('node:child_process');const p=c.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const r=c.spawnSync(process.execPath,[p+'/.codex/hooks/governance-gate.mjs'],{stdio:'inherit'});process.exit(r.status===null?2:r.status)\"",
            "timeout": 600,
            "statusMessage": "Running full repository verification"
          }
        ]
      }
    ]
  }
}
